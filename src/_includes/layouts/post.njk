---
layout: base
---

{% set lang = page.url | pageLang %}
{% set blogIndexUrl = '/es/blog/' if lang == 'es' else '/blog/' %}
{% set pageContent = actualitat.page %}
{% set articleDescription = seoDescription or description or title %}
{% set posts = collections.posts | filterByLang(lang) %}

<article class="actualitat-post">
  <div class="container actualitat-post__inner">
    <a class="actualitat-post__back" href="{% if lang == 'es' %}/es/blog/{% else %}/blog/{% endif %}">
      <img src="/assets/images/icon-arrow-left.svg" alt="" class="actualitat-post__back-arrow" aria-hidden="true" />
      {{ i18n[lang].postBack }}
    </a>

    <header class="actualitat-post__header">
      <time class="actualitat-post__date" datetime="{{ page.date | htmlDateString }}">
        {% if displayDate %}{{ displayDate }}{% else %}{{ page.date | readableDate }}{% endif %}
      </time>
      <h1 class="actualitat-post__title">{{ title }}</h1>
      {% if description %}
      <p class="actualitat-post__subtitle">{{ description }}</p>
      {% endif %}

      <div class="actualitat-post__meta" aria-label="{{ i18n[lang].postArticleInfoAria }}">
        <p>
          <strong>{{ i18n[lang].postReadingTime }}</strong>
          {% if readingTimeValue %}{{ readingTimeValue }}{% else %}{{ content | readingTime }} {{ i18n[lang].postMinutes }}{% endif %}
        </p>
        <p>
          <strong>{{ i18n[lang].postTags }}</strong>
          {% for tag in tags %}
            {% if tag != "posts" %}{{ tag }}{% if not loop.last %}, {% endif %}{% endif %}
          {% endfor %}
        </p>
      </div>
    </header>
  </div>

  {% if image %}
  <figure class="actualitat-post__hero-media">
    <img src="{{ image }}" alt="{{ imageAlt or title }}" loading="eager" decoding="async" />
  </figure>
  {% endif %}

  <div class="container actualitat-post__body">
    <div class="actualitat-post__content">
      {{ content | safe }}
    </div>

    {% if quote %}
    <aside class="actualitat-post__quote" aria-label="{{ i18n[lang].postQuoteAria }}">
      <blockquote>“{{ quote }}”</blockquote>
      {% if quoteAuthor %}
      <p>— {{ quoteAuthor }}</p>
      {% endif %}
    </aside>
    {% endif %}
  </div>

  {% for post in posts %}
    {% if post.url == page.url %}
      {% set previousPost = posts[loop.index] %}
      {% set nextPost = posts[loop.index0 - 1] if loop.index0 > 0 else null %}
  <nav class="container actualitat-post__nav" aria-label="{{ i18n[lang].postAriaRelated }}">
    {% if previousPost %}
    <a href="{{ previousPost.url }}">
      <img src="/assets/images/icon-arrow-left.svg" alt="" class="actualitat-post__nav-arrow" aria-hidden="true" />
      {{ i18n[lang].postPrevArticle }}
    </a>
    {% else %}
    <a href="{% if lang == 'es' %}/es/blog/{% else %}/blog/{% endif %}">
      <img src="/assets/images/icon-arrow-left.svg" alt="" class="actualitat-post__nav-arrow" aria-hidden="true" />
      {{ i18n[lang].postAllNews }}
    </a>
    {% endif %}
    {% if nextPost %}
    <a href="{{ nextPost.url }}">
      {{ i18n[lang].postNextArticle }}
      <img src="/assets/images/icon-arrow-right.svg" alt="" class="actualitat-post__nav-arrow" aria-hidden="true" />
    </a>
    {% else %}
    <a href="{% if lang == 'es' %}/es/blog/{% else %}/blog/{% endif %}">
      {{ i18n[lang].postBackToBlog }}
      <img src="/assets/images/icon-arrow-right.svg" alt="" class="actualitat-post__nav-arrow" aria-hidden="true" />
    </a>
    {% endif %}
  </nav>
    {% endif %}
  {% endfor %}
</article>

{% include "footer-newsletter-home.html" %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ (seoTitle or title) | dump | safe }},
    "description": {{ articleDescription | dump | safe }},
    "datePublished": {{ page.date.toISOString() | dump | safe }},
    "dateModified": {{ page.date.toISOString() | dump | safe }},
    "mainEntityOfPage": {{ (page.url | absoluteUrl(site.url)) | dump | safe }},
    "author": {
      "@type": "Organization",
      "name": {{ site.name | dump | safe }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ site.name | dump | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ ('/assets/images/logo.png' | absoluteUrl(site.url)) | dump | safe }}
      }
    }{% if image %},
    "image": [{{ (image | absoluteUrl(site.url)) | dump | safe }}]{% endif %}
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ i18n[lang].breadcrumbHome | dump | safe }},
        "item": {{ site.url | dump | safe }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ i18n[lang].breadcrumbActualitat | dump | safe }},
        "item": {{ (blogIndexUrl | absoluteUrl(site.url)) | dump | safe }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ title | dump | safe }},
        "item": {{ (page.url | absoluteUrl(site.url)) | dump | safe }}
      }
    ]
  }
</script>
