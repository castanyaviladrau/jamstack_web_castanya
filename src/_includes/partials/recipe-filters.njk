{% macro recipeFiltersBar(actionUrl, difficultyOptions, dishTypeOptions, searchLabel, showReset, recipes, lang) %}
{% set lang = lang or 'ca' %}
<form
  class="shop-page-filters__inner"
  action="{{ actionUrl }}"
  method="get"
  data-recipe-filter-form
>
  <details class="shop-page-filter-menu" data-recipe-filter-menu="difficulty" name="recipe-filter-group">
    <summary class="shop-page-filter" data-recipe-filter-summary data-default-label="{{ i18n[lang].recipeFilterDifficulty }}">
      <span data-recipe-filter-summary-label>{{ i18n[lang].recipeFilterDifficulty }}</span>
      <img class="shop-page-filter__arrow" src="/assets/images/recipe-filter-arrow.svg" alt="" aria-hidden="true" />
    </summary>
    <div class="shop-page-filter-menu__list">
      {% for value in difficultyOptions %}
      <button
        type="button"
        class="shop-page-filter-menu__item recipe-filter-menu__item"
        data-recipe-filter-option
        data-recipe-filter-value="{{ value }}"
        data-recipe-filter-label="{{ value | difficultyLabel(lang) }}"
      >{{ value | difficultyLabel(lang) }}</button>
      {% endfor %}
    </div>
    <input type="hidden" name="difficulty" data-recipe-filter-input value="" />
  </details>

  <details class="shop-page-filter-menu" data-recipe-filter-menu="time" name="recipe-filter-group">
    <summary class="shop-page-filter" data-recipe-filter-summary data-default-label="{{ i18n[lang].recipeFilterTime }}">
      <span data-recipe-filter-summary-label>{{ i18n[lang].recipeFilterTime }}</span>
      <img class="shop-page-filter__arrow" src="/assets/images/recipe-filter-arrow.svg" alt="" aria-hidden="true" />
    </summary>
    <div class="shop-page-filter-menu__list">
      <button type="button" class="shop-page-filter-menu__item recipe-filter-menu__item" data-recipe-filter-option data-recipe-filter-value="short" data-recipe-filter-label="{{ i18n[lang].recipeFilterTimeShort }}">{{ i18n[lang].recipeFilterTimeShort }}</button>
      <button type="button" class="shop-page-filter-menu__item recipe-filter-menu__item" data-recipe-filter-option data-recipe-filter-value="medium" data-recipe-filter-label="{{ i18n[lang].recipeFilterTimeMedium }}">{{ i18n[lang].recipeFilterTimeMedium }}</button>
      <button type="button" class="shop-page-filter-menu__item recipe-filter-menu__item" data-recipe-filter-option data-recipe-filter-value="long" data-recipe-filter-label="{{ i18n[lang].recipeFilterTimeLong }}">{{ i18n[lang].recipeFilterTimeLong }}</button>
    </div>
    <input type="hidden" name="time" data-recipe-filter-input value="" />
  </details>

  <details class="shop-page-filter-menu" data-recipe-filter-menu="dishType" name="recipe-filter-group">
    <summary class="shop-page-filter" data-recipe-filter-summary data-default-label="{{ i18n[lang].recipeFilterDishType }}">
      <span data-recipe-filter-summary-label>{{ i18n[lang].recipeFilterDishType }}</span>
      <img class="shop-page-filter__arrow" src="/assets/images/recipe-filter-arrow.svg" alt="" aria-hidden="true" />
    </summary>
    <div class="shop-page-filter-menu__list">
      {% for value in dishTypeOptions %}
      <button
        type="button"
        class="shop-page-filter-menu__item recipe-filter-menu__item"
        data-recipe-filter-option
        data-recipe-filter-value="{{ value }}"
        data-recipe-filter-label="{{ value | dishTypeLabel(lang) }}"
      >{{ value | dishTypeLabel(lang) }}</button>
      {% endfor %}
    </div>
    <input type="hidden" name="dishType" data-recipe-filter-input value="" />
  </details>

  {% if showReset %}
  <button type="button" class="shop-page-filter" data-recipe-results-reset hidden>
    {{ i18n[lang].recipeFilterReset }}
  </button>
  {% endif %}

  <div class="shop-page-search-wrap" data-recipe-search>
    <button type="submit" class="shop-page-search" data-recipe-search-toggle>
      {{ searchLabel }}
      <span aria-hidden="true">&rsaquo;</span>
    </button>
    <input
      type="search"
      class="shop-page-search-input"
      name="q"
      placeholder="{{ i18n[lang].recipeSearchPlaceholder }}"
      autocomplete="off"
      data-recipe-search-input
      hidden
    />
    <div class="shop-page-search-results" data-recipe-search-results hidden></div>
  </div>
</form>
{% if recipes %}
<script type="application/json" data-recipe-search-data>[
  {% for recipe in recipes %}
  {"title": {{ recipe.data.title | dump | safe }}, "url": {{ recipe.url | dump | safe }}}{% if not loop.last %},{% endif %}
  {% endfor %}
]</script>
{% endif %}
{% endmacro %}
